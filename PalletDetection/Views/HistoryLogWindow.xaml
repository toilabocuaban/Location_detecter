<Window x:Class="PalletDetection.Views.HistoryLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử gửi Task &amp; Nhật ký hoạt động · LOCATION DETECTER"
        Width="1060" Height="680" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" Foreground="#0F172A" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#122B49" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LỊCH SỬ GỬI TASK &amp; NHẬT KÝ HOẠT ĐỘNG" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="·  100 phiên gần nhất &amp; nhật ký chu kỳ AI / RCS V4.2" Foreground="#93C5FD" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Đóng" HorizontalAlignment="Right" Padding="14,5" Margin="0" Cursor="Hand" Click="OnCloseClick"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="0.9*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource HmiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#18385E" CornerRadius="7,7,0,0" Padding="14,8">
                        <TextBlock Text="LỊCH SỬ GỬI TASK RCS (100 PHIÊN GẦN NHẤT)" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <DataGrid x:Name="dgFullHistory" Grid.Row="1" Style="{StaticResource HmiDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeText}" Width="90"/>
                            <DataGridTextColumn Header="Mã Task" Binding="{Binding TaskCode}" Width="220"/>
                            <DataGridTextColumn Header="Tuyến" Binding="{Binding RouteText}" Width="165"/>
                            <DataGridTextColumn Header="Thời gian gọi" Binding="{Binding DurationText}" Width="110"/>
                            <DataGridTemplateColumn Header="Kết quả" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,8,0" Fill="#DC2626"/>
                                            <TextBlock x:Name="Txt" Text="{Binding ResultBadgeText}" FontWeight="SemiBold" Foreground="#DC2626" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ResultKind}" Value="Ok">
                                                <Setter TargetName="Dot" Property="Fill" Value="#16A34A"/>
                                                <Setter TargetName="Txt" Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Message}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource HmiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#18385E" CornerRadius="7,7,0,0" Padding="14,6">
                        <Grid>
                            <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG HỆ THỐNG" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="Xóa nhật ký" HorizontalAlignment="Right" Padding="10,3" FontSize="11.5" Cursor="Hand" Click="OnClearLogsClick"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="lstOperationLogs" Grid.Row="1" BorderThickness="0" Padding="6"
                             FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
