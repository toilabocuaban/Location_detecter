<Window x:Class="PalletDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOCATION DETECTER · ETEK"
        Height="880"
        Width="1400"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Foreground="#0F172A"
        FontFamily="Segoe UI"
        FontSize="13"
        Closing="Window_Closing">

    <Grid Background="#F1F5F9" TextElement.Foreground="#0F172A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. TOP NAVY HEADER BAR (NO TABS) ================= -->
        <Border Grid.Row="0" Background="#122B49" Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <Image Source="logo.jpg" Height="30" Stretch="Uniform"/>
                    </Border>
                    <Border Width="1.5" Height="34" Background="#335C8A" Margin="14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LOCATION DETECTER" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Hikvision Camera · YOLOv8 ONNX · RCS-2000 V4.2" Foreground="#93C5FD" FontSize="11.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="bdrModePill" Background="#64748B" CornerRadius="6" Padding="14,5" VerticalAlignment="Center">
                        <TextBlock x:Name="txtModePill" Text="STANDBY" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <Border Width="1.5" Height="24" Background="#335C8A" Margin="14,0"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Trạng thái kết nối Camera Hikvision RTSP">
                        <Ellipse x:Name="ellCameraDot" Width="12" Height="12" Margin="0,0,7,0" Fill="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="Camera" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Trạng thái Model AI YOLOv8">
                        <Ellipse x:Name="ellAiDot" Width="12" Height="12" Margin="0,0,7,0" Fill="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="AI" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlRcsIndicator" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="RCS: Đang kiểm tra kết nối...">
                        <Ellipse x:Name="ellRcsDot" Width="12" Height="12" Margin="0,0,7,0" Fill="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Text="RCS" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. MAIN WORKSPACE ================= -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FULL-WIDTH STATUS BANNER + START / STOP BUTTONS -->
            <Border x:Name="bdrStatusBanner" Grid.Row="0" Background="#FEF3C7" BorderBrush="#FBBF24" BorderThickness="1.5" CornerRadius="8" Padding="16,9" Margin="0,0,0,12">
                <Grid>
                    <TextBlock x:Name="txtSystemStatus"
                               Text="HỆ THỐNG: ĐANG KHỞI TẠO..."
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#92400E"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="180,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnStartOperation"
                                Content="▶  Khởi động"
                                Style="{StaticResource BannerStartButtonStyle}"
                                IsEnabled="False"
                                Margin="0,0,8,0"
                                Click="btnStartOperation_Click"/>
                        <Button x:Name="btnStopOperation"
                                Content="■  Dừng"
                                Style="{StaticResource BannerStopButtonStyle}"
                                IsEnabled="False"
                                Click="btnStopOperation_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2-COLUMN CONTENT GRID -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== LEFT COLUMN: LIVE VIEW & ROI (ALWAYS VISIBLE) ========== -->
                <Border Grid.Column="0" Style="{StaticResource HmiCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#18385E" CornerRadius="7,7,0,0" Padding="14,9">
                            <Grid>
                                <TextBlock Text="HÌNH ẢNH CAMERA / NHẬN DIỆN" Foreground="White" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtOpRoiInfo" Text="ROI: Toàn khung hình" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="0,0,7,7" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="gridLiveContainer"
                                      ClipToBounds="True"
                                      SizeChanged="gridLiveContainer_SizeChanged">
                                    <TextBlock Text="Đang chờ tín hiệu Camera Hikvision..." Foreground="#64748B" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Image x:Name="imgLive" Stretch="Uniform" Margin="6"/>
                                    <Canvas x:Name="canvasRoi"
                                            Background="Transparent"
                                            MouseDown="canvasRoi_MouseDown"
                                            MouseMove="canvasRoi_MouseMove"
                                            MouseUp="canvasRoi_MouseUp"/>
                                </Grid>

                                <Border Grid.Row="1" Background="#162235" Padding="12,7">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtCameraStatus" Text="Camera : OFFLINE" Foreground="#CBD5E1" FontSize="12"/>
                                        <TextBlock Text="  ·  " Foreground="#64748B" FontSize="12"/>
                                        <TextBlock x:Name="txtResolution" Text="Resolution : --" Foreground="#CBD5E1" FontSize="12"/>
                                        <TextBlock Text="  ·  " Foreground="#64748B" FontSize="12"/>
                                        <TextBlock x:Name="txtDetectionInfo" Text="AI : Sẵn sàng" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="  ·  " Foreground="#64748B" FontSize="12"/>
                                        <TextBlock x:Name="txtOpModelInfo" Text="Model: Chưa nạp" Foreground="#CBD5E1" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== RIGHT COLUMN: SWITCHES BETWEEN MONITORING & SETTINGS ========== -->
                <Grid Grid.Column="2">

                    <!-- PANEL A: MONITORING DASHBOARD (DEFAULT) -->
                    <Grid x:Name="pnlMonitoringPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LATEST RCS TASK RESULT CARD -->
                        <Border Grid.Row="0" Style="{StaticResource HmiCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="#18385E" CornerRadius="7,7,0,0" Padding="14,9">
                                    <TextBlock Text="KẾT QUẢ GỬI TASK GẦN NHẤT" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                        <Grid Width="46" Height="46" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Ellipse x:Name="ellResultCircle" Fill="#94A3B8"/>
                                            <Path x:Name="pathResultOk" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="24" Height="24" Stretch="Uniform" Data="M 4,13 L 10,19 L 20,6" Visibility="Collapsed"/>
                                            <Path x:Name="pathResultNg" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="20" Height="20" Stretch="Uniform" Data="M 4,4 L 20,20 M 20,4 L 4,20" Visibility="Collapsed"/>
                                            <Ellipse x:Name="ellResultIdle" Width="12" Height="12" Fill="White" Visibility="Visible"/>
                                        </Grid>

                                        <TextBlock x:Name="txtResultStatus" Text="CHỜ" FontSize="38" FontWeight="ExtraBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã Task:" Foreground="#334155" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtLastTaskCode" Grid.Row="0" Grid.Column="1" Text="-" IsReadOnly="True"
                                                     BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,4"
                                                     FontSize="15.5" FontWeight="Bold" Foreground="#1E3A8A"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời điểm:" Foreground="#334155" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="txtLastTaskTime" Grid.Row="1" Grid.Column="1" Text="--:--:--" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Thời gian gọi:" Foreground="#334155" FontSize="13.5" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtLastTaskDuration" Grid.Row="2" Grid.Column="1" Text="-" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                        </Grid>

                                        <TextBlock x:Name="txtRcsCycleStatus" Text="RCS: Đang kiểm tra kết nối..." FontSize="12" FontWeight="SemiBold" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="txtDetectSummary" Text="Nhận diện: Chưa có dữ liệu" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 3 KPI CARDS -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TỔNG" Foreground="#64748B" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiTotal" Text="0" Foreground="#0F172A" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="OK" Foreground="#15803D" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiOk" Text="0" Foreground="#15803D" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="NG" Foreground="#DC2626" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiNg" Text="0" Foreground="#DC2626" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- TASK HISTORY TABLE -->
                        <Border Grid.Row="2" Style="{StaticResource HmiCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#18385E" CornerRadius="7,7,0,0" Padding="14,9">
                                    <TextBlock Text="LỊCH SỬ GỬI TASK" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                                </Border>
                                <DataGrid x:Name="dgTaskHistory" Grid.Row="1" Style="{StaticResource HmiDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeText}" Width="88"/>
                                        <DataGridTextColumn Header="Mã Task / Tuyến" Binding="{Binding TaskAndRouteDisplay}" Width="210"/>
                                        <DataGridTemplateColumn Header="Kết quả" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse x:Name="BadgeCircle" Fill="#DC2626"/>
                                                            <Path x:Name="CheckPath" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Width="10" Height="10" Stretch="Uniform" Data="M 2,6 L 5,9 L 10,3" Visibility="Collapsed"/>
                                                            <Path x:Name="CrossPath" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="9" Height="9" Stretch="Uniform" Data="M 2,2 L 10,10 M 10,2 L 2,10" Visibility="Visible"/>
                                                        </Grid>
                                                        <TextBlock x:Name="BadgeText" Text="{Binding ResultBadgeText}" FontWeight="SemiBold" Foreground="#DC2626" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ResultKind}" Value="Ok">
                                                            <Setter TargetName="BadgeCircle" Property="Fill" Value="#16A34A"/>
                                                            <Setter TargetName="CheckPath" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CrossPath" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="ToolTip" Value="{Binding Message}"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- BOTTOM-RIGHT ACTION BUTTONS -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="btnOpenHistory" Style="{StaticResource NavyActionButtonStyle}" Margin="0,0,10,0" Click="btnOpenHistory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="15" Height="13" Stretch="Uniform" Data="M 1,2 H 3 M 6,2 H 16 M 1,7 H 3 M 6,7 H 16 M 1,12 H 3 M 6,12 H 16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Lịch sử" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnOpenSettings" Style="{StaticResource NavyActionButtonStyle}" Click="btnOpenSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="White" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"
                                          Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.67 19.18,11.36 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.88 L19.36,5.56 C19.24,5.36 19,5.28 18.78,5.36 L16.4,6.32 C15.9,5.94 15.36,5.62 14.78,5.38 L14.42,2.84 C14.38,2.62 14.19,2.46 13.96,2.46 L10.04,2.46 C9.81,2.46 9.62,2.62 9.58,2.84 L9.22,5.38 C8.64,5.62 8.1,5.94 7.6,6.32 L5.22,5.36 C5,5.28 4.76,5.36 4.64,5.56 L2.72,8.88 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.82,11.36 4.8,11.67 4.8,12 C4.8,12.33 4.82,12.64 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.12 L4.64,18.44 C4.76,18.64 5,18.72 5.22,18.64 L7.6,17.68 C8.1,18.06 8.64,18.38 9.22,18.62 L9.58,21.16 C9.62,21.38 9.81,21.54 10.04,21.54 L13.96,21.54 C14.19,21.54 14.38,21.38 14.42,21.16 L14.78,18.62 C15.36,18.38 15.9,18.06 16.4,17.68 L18.78,18.64 C19,18.72 19.24,18.64 19.36,18.44 L21.28,15.12 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.6 C10.01,15.6 8.4,13.99 8.4,12 C8.4,10.01 10.01,8.4 12,8.4 C13.99,8.4 15.6,10.01 15.6,12 C15.6,13.99 13.99,15.6 12,15.6 Z"/>
                                    <TextBlock Text="Cài đặt" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- PANEL B: ADMIN SETTINGS DRAWER (KEEPS LEFT CAMERA VISIBLE FOR ROI) -->
                    <Border x:Name="pnlSettingsPanel" Style="{StaticResource HmiCardStyle}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#18385E" CornerRadius="7,7,0,0" Padding="14,9">
                                <Grid>
                                    <TextBlock Text="CÀI ĐẶT HỆ THỐNG (QUẢN TRỊ VIÊN)" Foreground="White" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                    <Button x:Name="btnCloseSettings"
                                            Content="←  Quay lại Vận hành"
                                            HorizontalAlignment="Right"
                                            Background="#244B7A"
                                            Foreground="White"
                                            BorderBrush="#4773A6"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Padding="12,4"
                                            Cursor="Hand"
                                            Click="btnCloseSettings_Click"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12" Background="#F8FAFC">
                                <StackPanel>

                                    <!-- ADMIN AUTHENTICATION -->
                                    <Border Style="{StaticResource SettingsSectionBorderStyle}" Background="#F1F5F9">
                                        <StackPanel>
                                            <TextBlock Text="XÁC THỰC QUẢN TRỊ VIÊN" FontSize="13.5" FontWeight="Bold" Foreground="#18385E" Margin="0,0,0,6"/>
                                            <TextBlock Text="Mật khẩu Quản trị" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <PasswordBox x:Name="txtAdminPassword" Height="30" FontSize="13" Margin="0,2,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnAdminLogin" Grid.Column="0" Content="ĐĂNG NHẬP" Height="32" FontSize="12" FontWeight="Bold" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnAdminLogin_Click"/>
                                                <Button x:Name="btnAdminLogout" Grid.Column="2" Content="ĐĂNG XUẤT" Height="32" FontSize="12" FontWeight="Bold" Background="#64748B" Foreground="White" BorderThickness="0" IsEnabled="False" Cursor="Hand" Click="btnAdminLogout_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="txtAdminStatus" Text="Trạng thái: Chưa xác thực (Khóa cấu hình)" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PROTECTED SETTINGS CONTAINER -->
                                    <StackPanel x:Name="pnlAdminConfig" IsEnabled="False">

                                        <!-- ROI SETTINGS -->
                                        <Border Style="{StaticResource SettingsSectionBorderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="1. VÙNG QUAN SÁT ROI (Kéo chuột trên khung Camera bên trái)" FontSize="13" FontWeight="Bold" Foreground="#18385E" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="txtRoiStatus" Text="ROI: Toàn khung hình" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="btnDrawRoi" Grid.Column="0" Content="TẠO ROI" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="btnDrawRoi_Click"/>
                                                    <Button x:Name="btnClearRoi" Grid.Column="2" Content="XÓA ROI" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="btnClearRoi_Click"/>
                                                    <Button x:Name="btnSaveRoi" Grid.Column="4" Content="LƯU ROI" Style="{StaticResource SettingsSecondaryButtonStyle}" Background="#E0F2FE" Foreground="#0369A1" Click="btnSaveRoi_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- AI MODEL & DETECTION -->
                                        <Border Style="{StaticResource SettingsSectionBorderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="2. MÔ HÌNH AI &amp; KIỂM THỬ NHẬN DIỆN" FontSize="13" FontWeight="Bold" Foreground="#18385E" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="txtModelStatus" Text="Model: Chưa chọn" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <Button x:Name="btnSelectModel" Content="CHỌN MODEL (.ONNX)" Style="{StaticResource SettingsSecondaryButtonStyle}" Margin="0,0,0,6" Click="btnSelectModel_Click"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="btnDetect" Grid.Column="0" Content="SINGLE DETECTION" Height="34" FontSize="12" FontWeight="Bold" Background="#DBEAFE" Foreground="#1E40AF" BorderBrush="#93C5FD" BorderThickness="1" Cursor="Hand" Click="btnDetect_Click"/>
                                                    <Button x:Name="btnRealTime" Grid.Column="2" Content="REAL TIME DETECTION" Height="34" FontSize="12" FontWeight="Bold" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1" Cursor="Hand" Click="btnRealTime_Click"/>
                                                </Grid>
                                                <CheckBox x:Name="chkAutoSendRcsTask" Content="Tự động gửi Task RCS" IsChecked="True" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- RCS TASK CONFIGURATION -->
                                        <Border Style="{StaticResource SettingsSectionBorderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="3. CẤU HÌNH TASK RCS-2000 (V4.2)" FontSize="13" FontWeight="Bold" Foreground="#18385E" Margin="0,0,0,6"/>
                                                <TextBlock Text="RCS Apply Task URL" FontSize="12" Foreground="#475569"/>
                                                <TextBox x:Name="txtRcsUrl" Style="{StaticResource SettingsInputStyle}" TextWrapping="Wrap" Text="https://192.168.65.193/rcs/rtas/api/robot/controller/task/submit"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Task Type *" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtTaskType" Style="{StaticResource SettingsInputStyle}" Text="QF2"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Robot Code (trống: tự chọn)" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtRobotCode" Style="{StaticResource SettingsInputStyle}" Text="19781"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Pick-up Position" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtPickupPosition" Style="{StaticResource SettingsInputStyle}" Text="ETEK42"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Drop-off Position" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtDropoffPosition" Style="{StaticResource SettingsInputStyle}" Text="ETEK44"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Button x:Name="btnSaveRcsConfig" Content="SAVE RCS CONFIGURATION" Style="{StaticResource NavyActionButtonStyle}" Margin="0,4,0,0" Click="btnSaveRcsConfig_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- CAMERA CONNECTION & STREAM -->
                                        <Border Style="{StaticResource SettingsSectionBorderStyle}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="4. CAMERA HIKVISION &amp; STREAM" FontSize="13" FontWeight="Bold" Foreground="#18385E" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="0.6*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="IP Address" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtIP" Style="{StaticResource SettingsInputStyle}" Text="192.168.1.64"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Port" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtPort" Style="{StaticResource SettingsInputStyle}" Text="8000"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Username" FontSize="12" Foreground="#475569"/>
                                                        <TextBox x:Name="txtUsername" Style="{StaticResource SettingsInputStyle}" Text="admin"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Password" FontSize="12" Foreground="#475569"/>
                                                        <PasswordBox x:Name="txtPassword" Height="30" FontSize="12.5" Margin="0,2,0,6"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,2,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="btnConnect" Grid.Column="0" Content="CONNECT CAMERA" Style="{StaticResource NavyActionButtonStyle}" Padding="10,6" FontSize="12" Click="btnConnect_Click"/>
                                                    <Button x:Name="btnSaveCameraConfig" Grid.Column="2" Content="LƯU CAMERA (DPAPI)" Style="{StaticResource SettingsSecondaryButtonStyle}" Background="#E0F2F1" Foreground="#0F766E" Click="btnSaveCameraConfig_Click"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="btnStartLive" Grid.Column="0" Content="START LIVE" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="btnStartLive_Click"/>
                                                    <Button x:Name="btnStopLive" Grid.Column="2" Content="STOP LIVE" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="btnStopLive_Click"/>
                                                    <Button x:Name="btnSaveImage" Grid.Column="4" Content="SAVE IMAGE" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="btnSaveImage_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
